# =================================================================
# HOUSEHOLD Frontend Environment Configuration Example
# Скопируйте этот файл в .env перед сборкой:
# cp .env.example .env
# =================================================================

# Web Client ID от Google Identity Services (Google Cloud Console -> APIs -> Credentials)
# Пример: 123456789012-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
